{
  "name": "brightness-perception-experiment",
  "version": "2.0.0",
  "private": true,
  "description": "Online jsPsych experiment: does word valence bias perceived brightness?",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "check:sri": "node scripts/check-sri.mjs"
  },
  "devDependencies": {
    "@jspsych/plugin-browser-check": "2.1.0",
    "@jspsych/plugin-fullscreen": "2.1.0",
    "@jspsych/plugin-html-button-response": "2.1.0",
    "@jspsych/plugin-html-keyboard-response": "2.2.0",
    "@jspsych/plugin-instructions": "2.1.0",
    "@playwright/test": "1.56.1",
    "jspsych": "8.3.0"
  }
}
